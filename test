        layout: { visibility: "none" },
        paint: { "fill-color": "#01796F", "fill-opacity": 0.15 }
    });

    map.addLayer({
        id: "cemetery-boundary-outline",
        type: "line",
        source: "cemetery-boundary",
        layout: { visibility: "none" },
        paint: { "line-color": "#01796F", "line-width": 2.5, "line-opacity": 0.9 }
    });

    loadTestBoundary();

    // ---- shared physical marker layers (hidden until needed) ----
    map.addSource("shared-markers-data", { type: "geojson", data: EMPTY_COLLECTION });

    // ---- individual grave layer (hidden until needed) ----
    map.addSource("graves-data", { type: "geojson", data: EMPTY_COLLECTION });

    // ---- main cemetery CSV ----
    Papa.parse(CSV_PATH, {

        download: true,
        header: true,
        skipEmptyLines: true,

        complete: function (results) {

            const mapFeatures = [];

            results.data.forEach(function (row) {

                const lat = parseFloat(row.LAT);
                const lon = parseFloat(row.LONG);

                if (isNaN(lat) || isNaN(lon)) {
                    return;
                }

                const graveCount =
                    row["COUNT"] === undefined || String(row["COUNT"]).trim() === ""
                        ? -1
                        : parseInt(row["COUNT"], 10);

                const access = parseInt(row.ACCESS, 10);
                const status = parseInt(row.STATUS, 10);
                const vets = parseInt(row.VETS, 10);

                mapFeatures.push({
                    type: "Feature",
                    properties: {
                        Cemetery_ID: row.ID || "",
                        Cemetery_Name: row.NAME || "",
                        Other_Names: row["OTHER NAMES"] || "",
                        Township: row.TOWNSHIP || "",
                        Established_Year: parseInt(row["EST."], 10) || 0,
                        Grid_Index: row["MAP LOCATION"] || "",
                        General_Notes: row.NOTES || "",
                        Condition_Notes: row.CONDITION || "",
                        Grave_Count: isNaN(graveCount) ? -1 : graveCount,
                        Access: isNaN(access) ? -1 : access,
                        Approximate_Size: row["APPROXIMATE SIZE"] || "",
                        Status: isNaN(status) ? -1 : status,
                        Vets: isNaN(vets) ? -1 : vets,
                        Search_Match: false,
                        Search_Active: false
                    },
                    geometry: { type: "Point", coordinates: [lon, lat] }
                });
            });

            cemeteryFeatures = mapFeatures;

            map.addSource("cemeteries-data", {
                type: "geojson",
                data: { type: "FeatureCollection", features: mapFeatures }
            });

            // ---- main cemetery markers ----
            map.addLayer({
                id: "cemeteries-layer",
                type: "circle",
                source: "cemeteries-data",
                paint: {
                    "circle-radius": [
                        "case",
                        ["<", ["get", "Grave_Count"], 0],
                        8,
                        ["step", ["get", "Grave_Count"], 6, 25, 8, 100, 11, 250, 14, 500, 18]
                    ],
                    "circle-color": [
                        "case",
                        ["<", ["get", "Grave_Count"], 0],
                        "#777777",
                        [
                            "match", ["get", "Access"],
                            0, "#8B0000",
                            1, "#D2691E",
                            2, "#C9A227",
                            3, "#01796F",
                            "#777777"
                        ]
                    ],
                    "circle-stroke-width": 2,
                    "circle-stroke-color": "#ffffff"
                }
            });

            // ---- search highlight ring ----
            map.addLayer({
                id: "cemeteries-highlight-layer",
                type: "circle",
                source: "cemeteries-data",
                filter: [
                    "all",
                    ["==", ["get", "Search_Active"], true],
                    ["==", ["get", "Search_Match"], true]
                ],
                paint: {
                    "circle-radius": 12,
                    "circle-color": "#ffffff",
                    "circle-opacity": 0,
                    "circle-stroke-width": 4,
                    "circle-stroke-color": "#FFD700",
                    "circle-stroke-opacity": 0.95
                }
            });

            // ---- individual graves ----
            map.addLayer({
                id: "graves-layer",
                type: "circle",
                source: "graves-data",
                layout: { visibility: "none" },
                paint: {
                    "circle-radius": 5,
                    "circle-color": "#463a2d",
                    "circle-opacity": 0.92,
                    "circle-stroke-width": 2,
                    "circle-stroke-color": "#ffffff"
                }
            });

            // ---- shared markers: outer ring is the (larger) click target ----
            map.addLayer({
                id: "shared-markers-outer-layer",
                type: "circle",
                source: "shared-markers-data",
                layout: { visibility: "none" },
                paint: {
                    "circle-radius": 8,
                    "circle-color": "#ffffff",
                    "circle-opacity": 0,
                    "circle-stroke-width": 2,
                    "circle-stroke-color": "#463a2d",
                    "circle-stroke-opacity": 0.95
                }
            });

            map.addLayer({
                id: "shared-markers-inner-layer",
                type: "circle",
                source: "shared-markers-data",
                layout: { visibility: "none" },
                paint: {
                    "circle-radius": 4,
                    "circle-color": "#463a2d",
                    "circle-opacity": 0.92,
                    "circle-stroke-width": 1.5,
                    "circle-stroke-color": "#ffffff"
                }
            });

            // ---------------- CLICK HANDLERS ----------------
            map.on("click", "cemeteries-layer", handleCemeteryClick);
            map.on("click", "graves-layer", handleGraveClick);
            map.on("click", "shared-markers-outer-layer", handleSharedMarkerClick);

            // ---------------- HOVER: cemeteries ----------------
            function cemeteryHover(event) {
                const feature = event.features && event.features[0];

                if (feature) {
                    showHoverLabel(
                        feature.properties.Cemetery_Name || "Unnamed Cemetery",
                        event.lngLat
                    );
                }
            }

            map.on("mouseenter", "cemeteries-layer", function (event) {
                map.getCanvas().style.cursor = "pointer";
                cemeteryHover(event);
            });

            map.on("mousemove", "cemeteries-layer", cemeteryHover);

            map.on("mouseleave", "cemeteries-layer", function () {
                map.getCanvas().style.cursor = "";
                removeHoverLabel();
            });

            // ---------------- HOVER: graves ----------------
            function graveHover(event) {
                const feature = event.features && event.features[0];

                if (feature) {
                    showHoverLabel(
                        feature.properties.Person_Name || "Unnamed Interment",
                        event.lngLat
                    );
                }
            }

            map.on("mouseenter", "graves-layer", function (event) {
                map.getCanvas().style.cursor = "pointer";
                graveHover(event);
            });

            map.on("mousemove", "graves-layer", graveHover);

            map.on("mouseleave", "graves-layer", function () {
                map.getCanvas().style.cursor = "";
                removeHoverLabel();
            });

            // ---------------- HOVER: shared markers ----------------
            function sharedHover(event) {
                const feature = event.features && event.features[0];

                if (feature) {
                    showHoverLabel(
                        "Marker for " + feature.properties.Person_Count + " people",
                        event.lngLat
                    );
                }
            }

            map.on("mouseenter", "shared-markers-outer-layer", function (event) {
                map.getCanvas().style.cursor = "pointer";
                sharedHover(event);
            });

            map.on("mousemove", "shared-markers-outer-layer", sharedHover);

            map.on("mouseleave", "shared-markers-outer-layer", function () {
                map.getCanvas().style.cursor = "";
                removeHoverLabel();
            });

            // Hover labels only appear on desktop; showHoverLabel()
            // already checks that, so the handlers above are safe on touch.

            // ---------------- LOAD OTHER DATA ----------------
            loadInterments(INTERMENTS_CSV_PATH);
            loadLakeCemeteries(LAKE_CSV_PATH);

            processMapFilters();
        },

        error: function (error) {

            console.error("cemlist.csv loading error:", error);

            infoContent.innerHTML = `
                <div class="error-message">
                    <strong>Error:</strong>
                    Unable to load cemlist.csv.
                    <br><br>
                    Make sure the file is uploaded to the same repository
                    folder as index.html.
                </div>`;
        }
    });
});


// ============================================================
// MAP-WIDE CLICK TO EXIT CEMETERY MODE
// ============================================================

map.on("click", function (event) {

    if (!selectedCemeteryFeature) {
        return;
    }

    const layers = [
        "cemeteries-layer",
        "cemeteries-highlight-layer",
        "graves-layer",
        "shared-markers-outer-layer",
        "shared-markers-inner-layer",
        "lake-cemeteries-layer"
    ].filter(function (id) {
        return map.getLayer(id);
    });

    if (layers.length) {
        const hits = map.queryRenderedFeatures(event.point, { layers: layers });

        if (hits.length) {
            return;
        }
    }

    exitCemeteryMode();
});


// ============================================================
// SEARCH / FILTER CONTROLS
// ============================================================

searchBox.addEventListener("input", processMapFilters);

clearSearch.addEventListener("click", function () {
    searchBox.value = "";
    processMapFilters();
    searchBox.focus();
});

cemeteryToggle.addEventListener("click", function () {
    searchCemetery = !searchCemetery;
    cemeteryToggle.classList.toggle("active", searchCemetery);
    processMapFilters();
});

personToggle.addEventListener("click", function () {
    searchPerson = !searchPerson;
    personToggle.classList.toggle("active", searchPerson);
    processMapFilters();
});

veteransToggle.addEventListener("click", function () {
    veteransOnly = !veteransOnly;
    veteransToggle.classList.toggle("active", veteransOnly);
    processMapFilters();
});

yearSlider.addEventListener("input", processMapFilters);


// ============================================================
// KEEP SEARCH DIRECTIONS IN SYNC WITH THE MAP
// ============================================================

map.on("move", updateSearchDirections);
map.on("resize", updateSearchDirections);


// ============================================================
// RESET FILTERS
// ============================================================

resetButton.addEventListener("click", function () {

    if (selectedCemeteryFeature) {
        selectedCemeteryFeature = null;
        removeHoverLabel();
        updateCemeteryBoundary();
        updateCemeteryGraves();
    }

    searchBox.value = "";
    searchCemetery = true;
    searchPerson = true;
    veteransOnly = false;

    cemeteryToggle.classList.add("active");
    personToggle.classList.add("active");
    veteransToggle.classList.remove("active");

    yearSlider.value = 1900;
    yearVal.innerText = "All";

    processMapFilters();

    infoPanel.style.display = "block";
    showDefaultInfo();
});

</script>

</body>
</html>
