// GRAVE CLICK HANDLER
// ============================================================

function handleGraveClick(event) {

    if (!event.features || !event.features.length) {
        return;
    }

    const props = event.features[0].properties;

    infoPanel.style.display = "block";

    const cemetery = findCemetery(props.Cemetery_ID);

    // The full person record travels in Person_Data.
    let person = null;

    if (props.Person_Data) {
        try {
            const parsed = JSON.parse(props.Person_Data);

            if (Array.isArray(parsed) && parsed.length) {
                person = parsed[0];
            }
        }
        catch (error) {
            console.error("Unable to parse Person_Data:", error);
        }
    }

    // Fallback for an ordinary grave feature.
    if (!person) {
        person = {
            name: props.Person_Name || "Unnamed Interment",
            veteran: props.Veteran === true,
            birth: props.Birth || "",
            death: props.Death || "",
            row: props.Row || "",
            plot: props.Plot || "",
            stoneInfo: props.Stone_Info || "",
            vetDetails: props.Vet_Details || "",
            markerID: props.Marker_ID || ""
        };
    }

    const cemeteryName = cemetery ? cemetery.properties.Cemetery_Name : props.Cemetery_ID;

    function section(title, value) {
        return `<h3>${title}</h3><p>${escapeHtml(value)}</p>`;
    }

    let html = `<h2>${escapeHtml(person.name || "Unnamed Interment")}</h2>`;

    html += section("Cemetery", cemeteryName || "");

    if (person.birth) { html += section("Birth", person.birth); }
    if (person.death) { html += section("Death", person.death); }

    html += section("Veteran", person.veteran ? "Yes" : "No");

    if (person.vetDetails) { html += section("Veteran Details", person.vetDetails); }
    if (person.row) { html += section("Row", person.row); }
    if (person.plot) { html += section("Plot", person.plot); }
    if (person.stoneInfo) { html += section("Additional Information on Stone", person.stoneInfo); }
    if (person.markerID) { html += section("Marker ID", person.markerID); }

    infoContent.innerHTML = html;

    if (event.originalEvent) {
        event.originalEvent.stopPropagation();
    }
}


