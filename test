<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Franklin County Indiana Pioneer Cemeteries Archive Prototype</title>

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css">
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
<script src="https://unpkg.com/papaparse@5.4.1/papaparse.min.js"></script>

<style>
    * { box-sizing: border-box; }

    html, body {
        margin: 0; padding: 0; width: 100%; height: 100%;
        font-family: Arial, Helvetica, sans-serif;
    }

    body { display: flex; flex-direction: column; background: #f4f1e8; }

    /* ---------- HEADER ---------- */
    header { background: #01796F; color: white; padding: 14px 18px; z-index: 10; }
    header h1 { margin: 0 0 5px 0; font-size: 22px; }
    header p { margin: 0; font-size: 14px; opacity: 0.9; }

    /* ---------- CONTROLS ---------- */
    #controls {
        background: #eee9dc; border-bottom: 1px solid #c9c1b2; padding: 10px;
        display: flex; flex-wrap: wrap; gap: 8px; align-items: center; z-index: 5;
    }

    /* ---------- SEARCH ---------- */
    #search-wrapper { position: relative; flex: 1 1 220px; min-width: 180px; }

    #search {
        width: 100%; padding: 9px 34px 9px 10px;
        border: 1px solid #aaa; border-radius: 4px; font-size: 15px;
    }

    #clear-search {
        position: absolute; top: 50%; right: 5px; transform: translateY(-50%);
        width: 26px; height: 26px; padding: 0; border: none; border-radius: 50%;
        background: transparent; color: #777; font-size: 20px; line-height: 26px;
        cursor: pointer; display: none;
    }
    #clear-search:hover { background: #e5e0d5; color: #333; }

    /* ---------- SEARCH TOGGLES ---------- */
    #search-toggles { display: flex; gap: 4px; align-items: center; }

    .search-toggle {
        padding: 8px 11px; border: 1px solid #aaa; border-radius: 4px;
        background: #ddd8cc; color: #463a2d; font-size: 13px; font-weight: normal; cursor: pointer;
    }
    .search-toggle:hover { background: #cfc8bb; }
    .search-toggle.active { background: #01796F; border-color: #01796F; color: white; }
    .search-toggle.active:hover { background: #463a2d; border-color: #463a2d; }

    /* ---------- YEAR FILTER ---------- */
    #year-filter-container { display: flex; align-items: center; gap: 8px; padding: 0 4px; }
    #year-filter-label { font-size: 14px; white-space: nowrap; color: #3f3528; }
    #year-filter { width: 150px; cursor: pointer; }
    #year-value { min-width: 42px; font-weight: bold; font-size: 14px; color: #3f3528; text-align: center; }

    /* ---------- BUTTONS ---------- */
    button {
        padding: 9px 14px; border: 1px solid #8d8375; border-radius: 4px;
        background: #01796F; color: white; font-size: 14px; cursor: pointer;
    }
    button:hover { background: #463a2d; }

    .see-more-button {
        display: block; width: 100%; padding: 10px 14px;
        border: 1px solid #8d8375; border-radius: 4px;
        background: #01796F; color: white; font-size: 14px; font-weight: bold;
        text-align: center; cursor: pointer;
    }
    .see-more-button:hover { background: #463a2d; }

    .shared-marker-person-button,
    .shared-marker-view-all-button {
        display: block; width: 100%; margin: 7px 0; padding: 10px 12px;
        border: 1px solid #8d8375; border-radius: 4px;
        background: #01796F; color: white; font-size: 14px; font-weight: bold;
        text-align: left; cursor: pointer;
    }
    .shared-marker-person-button:hover,
    .shared-marker-view-all-button:hover { background: #463a2d; }
    .shared-marker-view-all-button { text-align: center; margin-top: 12px; }

    /* ---------- POPUP CONTENT ---------- */
    .cemetery-popup-photo {
        display: block; width: 100%; height: auto; max-height: 220px;
        object-fit: contain; margin: 0 0 12px 0; border-radius: 4px;
    }

    .popup-field { display: grid; grid-template-columns: 130px 1fr; column-gap: 10px; margin-bottom: 8px; }
    .popup-label { font-weight: bold; }

    .lake-cemetery { border-top: 1px solid #ddd; padding: 12px 0; }
    .lake-cemetery:first-child { border-top: none; }
    .lake-cemetery h3 { margin: 0 0 10px 0; font-size: 16px; color: #463a2d; }
    .lake-introduction { margin: 0 0 12px 0; line-height: 1.4; font-size: 14px; }

    /* ---------- MAP ---------- */
    #map { flex: 1; min-height: 0; width: 100%; position: relative; }

    /* ---------- INFO PANEL ---------- */
    #info-panel {
        position: absolute; top: 10px; right: 10px; width: 310px;
        max-width: calc(100% - 20px); max-height: calc(100% - 20px);
        overflow-y: auto; background: rgba(255, 255, 255, 0.96);
        border: 1px solid #aaa; border-radius: 5px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
        padding: 14px; z-index: 4;
    }

    #close-info {
        position: absolute; top: 5px; right: 7px; width: 28px; height: 28px; padding: 0;
        border: none; border-radius: 50%; background: transparent; color: #5a4b3a;
        font-size: 23px; line-height: 28px; cursor: pointer;
    }
    #close-info:hover { background: #e5e0d5; color: #2f281f; }

    #info-content { padding-right: 24px; }
    #info-panel h2 { margin: 0 0 6px 0; font-size: 20px; color: #3f3528; }
    #info-panel h3 { margin: 12px 0 3px 0; font-size: 13px; color: #6b6258; text-transform: uppercase; }
    #info-panel p { margin: 0; line-height: 1.4; font-size: 14px; }

    .placeholder { color: #666; font-size: 14px; line-height: 1.4; }
    .error-message { color: #8b0000; font-size: 14px; line-height: 1.45; }

    /* ---------- LIGHTBOX ---------- */
    #cemetery-lightbox {
        display: none; position: absolute; inset: 0;
        background: rgba(0, 0, 0, 0.78); z-index: 20;
        align-items: center; justify-content: center; padding: 20px;
    }

    #cemetery-lightbox-frame {
        width: min(1100px, 95%); height: min(850px, 92%);
        border: none; border-radius: 5px; background: white;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    #close-cemetery-lightbox {
        position: absolute; top: 15px; right: 20px; width: 38px; height: 38px; padding: 0;
        border: none; border-radius: 50%; background: rgba(255, 255, 255, 0.92);
        color: #3f3528; font-size: 28px; line-height: 38px; cursor: pointer; z-index: 21;
    }
    #close-cemetery-lightbox:hover { background: white; color: #01796F; }

    /* ---------- HOVER LABELS ---------- */
    .map-hover-popup .maplibregl-popup-content {
        padding: 6px 9px; border: 1px solid rgba(90, 75, 58, 0.55); border-radius: 14px;
        background: rgba(255, 255, 255, 0.96); box-shadow: 0 2px 7px rgba(0, 0, 0, 0.25);
        color: #3f3528; font-size: 12px; font-weight: bold; line-height: 1.15; white-space: nowrap;
    }
    .map-hover-popup .maplibregl-popup-tip {
        border-top-color: rgba(255, 255, 255, 0.96);
        border-bottom-color: rgba(255, 255, 255, 0.96);
    }

    /* ---------- ACCESSIBILITY LEGEND ---------- */
    #accessibility-legend {
        position: absolute; top: 10px; left: 10px; z-index: 10;
        background: rgba(255, 255, 255, 0.96); border: 1px solid #aaa; border-radius: 5px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25); overflow: hidden;
        font-family: Arial, Helvetica, sans-serif;
    }

    #legend-toggle {
        width: 110px; padding: 8px 10px; border: none; border-radius: 0;
        background: white; color: #3f3528; font-size: 13px; font-weight: bold;
        display: flex; align-items: center; justify-content: space-between; cursor: pointer;
    }
    #legend-toggle:hover { background: #eee9dc; color: #3f3528; }

    #legend-content { display: none; min-width: 180px; padding: 8px 12px 11px 12px; border-top: 1px solid #ddd; }
    .legend-title { margin-bottom: 7px; font-size: 11px; font-weight: bold; color: #555; }
    .legend-item { display: flex; align-items: center; gap: 8px; margin: 5px 0; font-size: 13px; line-height: 1.4; white-space: nowrap; }
    .legend-circle {
        display: inline-block; width: 14px; height: 14px; min-width: 14px;
        border-radius: 50%; border: 1px solid rgba(0, 0, 0, 0.25);
    }

    /* ---------- OFF-SCREEN SEARCH DIRECTIONS ---------- */
    #search-directions { position: absolute; inset: 0; z-index: 3; pointer-events: none; overflow: hidden; }

    .search-direction {
        position: absolute; display: flex; align-items: center; gap: 5px; max-width: 210px;
        padding: 5px 8px 5px 6px; border: 1px solid rgba(90, 75, 58, 0.55); border-radius: 14px;
        background: rgba(255, 255, 255, 0.94); box-shadow: 0 2px 7px rgba(0, 0, 0, 0.25);
        color: #3f3528; font-size: 12px; font-weight: bold; line-height: 1.15;
        white-space: nowrap; pointer-events: auto; cursor: pointer; transform-origin: center center;
    }
    .search-direction:hover { background: white; border-color: #463a2d; }

    .search-direction-arrow {
        display: inline-block; width: 16px; min-width: 16px; text-align: center;
        font-size: 18px; line-height: 16px; color: #FFD700;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.65); transform-origin: center center;
    }

    .search-direction-name { overflow: hidden; text-overflow: ellipsis; }

    /* ---------- MOBILE ---------- */
    @media (max-width: 700px) {

        .search-direction { max-width: 60vw; padding: 5px 7px 5px 5px; font-size: 11px; }
        .search-direction-arrow { width: 15px; min-width: 15px; font-size: 17px; }

        header { padding: 11px 13px; }
        header h1 { font-size: 18px; }
        header p { font-size: 12px; }

        #controls { padding: 8px; }
        #search, #controls > button { width: 100%; flex: 1 1 100%; }
        #search-toggles { width: 100%; flex: 1 1 100%; }
        .search-toggle { flex: 1; }
        #year-filter-container { width: 100%; flex: 1 1 100%; }
        #year-filter { flex: 1; width: auto; }

        #info-panel {
            position: absolute; top: auto; right: 8px; bottom: 8px; left: 8px;
            width: auto; max-width: none; max-height: 65%;
        }

        .popup-field { grid-template-columns: 120px 1fr; }

        #cemetery-lightbox { padding: 10px; }
        #cemetery-lightbox-frame { width: 100%; height: 90%; }
        #close-cemetery-lightbox { top: 5px; right: 8px; }
    }
</style>
</head>

<body>

<header>
    <h1>Franklin County Indiana Pioneer Cemeteries Archive Prototype</h1>
    <p>Historic Cemetery Locations and Associated Records</p>
</header>

<div id="controls">

    <div id="search-wrapper">
        <input type="text" id="search" placeholder="Search cemeteries or people...">
        <button id="clear-search" type="button" title="Clear search">&times;</button>
    </div>

    <div id="search-toggles">
        <button type="button" class="search-toggle active" id="search-cemetery">Cemetery</button>
        <button type="button" class="search-toggle active" id="search-person">Person</button>
        <button type="button" class="search-toggle" id="search-veterans">Veterans Only</button>
    </div>

    <div id="year-filter-container">
        <span id="year-filter-label">Established Before:</span>
        <input type="range" id="year-filter" min="1800" max="1900" step="5" value="1900">
        <span id="year-value">All</span>
    </div>

    <button id="reset-btn">Reset Filters</button>

</div>

<div id="map">

    <div id="search-directions"></div>

    <div id="accessibility-legend">
        <button id="legend-toggle" type="button" aria-expanded="false" aria-controls="legend-content">
            <span>Legend</span>
            <span id="legend-arrow">▾</span>
        </button>

        <div id="legend-content">
            <div class="legend-title">ACCESSIBILITY</div>
            <div class="legend-item"><span class="legend-circle" style="background-color: #01796F;"></span><span>Public</span></div>
            <div class="legend-item"><span class="legend-circle" style="background-color: #C9A227;"></span><span>With Permission</span></div>
            <div class="legend-item"><span class="legend-circle" style="background-color: #D2691E;"></span><span>Private Land</span></div>
            <div class="legend-item"><span class="legend-circle" style="background-color: #8B0000;"></span><span>Inaccessible</span></div>
            <div class="legend-item"><span class="legend-circle" style="background-color: #777777;"></span><span>Unknown</span></div>
        </div>
    </div>

    <div id="info-panel">
        <button id="close-info" title="Close Panel">&times;</button>
        <div id="info-content">
            <div class="placeholder">
                Click a cemetery marker on the map to inspect historic records and notes.
            </div>
        </div>
    </div>

    <div id="cemetery-lightbox">
        <button id="close-cemetery-lightbox" title="Close Cemetery Record">&times;</button>
        <iframe id="cemetery-lightbox-frame" title="Cemetery Record"></iframe>
    </div>

</div>

<script>

// ============================================================
// MAP SETUP
// ============================================================

const DEFAULT_CENTER = [-85.0626, 39.3992];
const DEFAULT_ZOOM = 11;

const map = new maplibregl.Map({
    container: "map",
    style: {
        version: 8,
        sources: {
            "osm-tiles": {
                type: "raster",
                tiles: ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
                tileSize: 256,
                attribution: "© OpenStreetMap contributors"
            }
        },
        layers: [{ id: "osm-layer", type: "raster", source: "osm-tiles" }]
    },
    zoom: DEFAULT_ZOOM,
    center: DEFAULT_CENTER,
    maxBounds: [[-85.50, 39.10], [-84.65, 39.70]],
    maxZoom: 30
});


// ============================================================
// DOM REFERENCES
// ============================================================

const infoPanel = document.getElementById("info-panel");
const infoContent = document.getElementById("info-content");
const searchBox = document.getElementById("search");
const clearSearch = document.getElementById("clear-search");
const searchDirections = document.getElementById("search-directions");
const cemeteryToggle = document.getElementById("search-cemetery");
const personToggle = document.getElementById("search-person");
const veteransToggle = document.getElementById("search-veterans");
const yearSlider = document.getElementById("year-filter");
const yearVal = document.getElementById("year-value");
const resetButton = document.getElementById("reset-btn");
const cemeteryLightbox = document.getElementById("cemetery-lightbox");
const cemeteryLightboxFrame = document.getElementById("cemetery-lightbox-frame");
const closeCemeteryLightbox = document.getElementById("close-cemetery-lightbox");
const legendToggle = document.getElementById("legend-toggle");
const legendContent = document.getElementById("legend-content");
const legendArrow = document.getElementById("legend-arrow");


// ============================================================
// APPLICATION STATE
// ============================================================

let cemeteryFeatures = [];

// intermentsByCemetery[id] = {
//   people:      [full names],
//   veteran:     true if any interment is a veteran,
//   coordinates: [[lon, lat], ...]  (graves that have GPS),
//   rows:        [person, ...]      (every interment),
//   groups:      { MARKER_ID: [person, ...] }
// }
let intermentsByCemetery = {};
let intermentsLoaded = false;

// test-cemetery.geojson contains the test polygon under
// CEMETERY_ID = TEST001. That polygon represents the real
// cemetery whose cemlist.csv ID is FC0202.
const TEST_BOUNDARY_CEMETERY_ID = "FC0202";
const TEST_BOUNDARY_FILE = "test-cemetery.geojson";

let testBoundaryData = null;
let selectedCemeteryFeature = null;
let hoverPopup = null;

let searchCemetery = true;
let searchPerson = true;
let veteransOnly = false;


// ============================================================
// SMALL HELPERS
// ============================================================

function desktopHoverEnabled() {
    return window.matchMedia("(hover: hover) and (pointer: fine)").matches;
}

function escapeHtml(value) {
    return String(value == null ? "" : value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}

function cleanString(value) {
    return String(value == null ? "" : value).trim();
}

function popupField(label, value) {
    return `
        <div class="popup-field">
            <span class="popup-label">${label}:</span>
            <span>${escapeHtml(value)}</span>
        </div>`;
}

function showHoverLabel(text, coordinates) {

    if (!desktopHoverEnabled() || !text) {
        return;
    }

    if (!hoverPopup) {
        hoverPopup = new maplibregl.Popup({
            closeButton: false,
            closeOnClick: false,
            offset: 12,
            className: "map-hover-popup"
        });
    }

    hoverPopup.setLngLat(coordinates).setHTML(escapeHtml(text)).addTo(map);
}

function removeHoverLabel() {
    if (hoverPopup) {
        hoverPopup.remove();
    }
}

function showDefaultInfo() {
    infoContent.innerHTML = `
        <div class="placeholder">
            Click a cemetery marker on the map to inspect historic records and notes.
        </div>`;
}

function getGroups(cemeteryID) {
    const data = intermentsByCemetery[cemeteryID];
    return (data && data.groups) || {};
}

function findCemetery(cemeteryID) {
    const id = cleanString(cemeteryID);
    return cemeteryFeatures.find(function (feature) {
        return cleanString(feature.properties.Cemetery_ID) === id;
    });
}


// ============================================================
// INFO PANEL / LIGHTBOX / LEGEND CONTROLS
// ============================================================

document.getElementById("close-info").addEventListener("click", function () {
    infoPanel.style.display = "none";
});

function closeCemeteryRecord() {
    cemeteryLightbox.style.display = "none";
    cemeteryLightboxFrame.src = "";
}

closeCemeteryLightbox.addEventListener("click", closeCemeteryRecord);

document.addEventListener("keydown", function (event) {
    if (event.key === "Escape" && cemeteryLightbox.style.display === "flex") {
        closeCemeteryRecord();
    }
});

legendToggle.addEventListener("click", function (event) {

    // Keep this click from being treated as a map click.
    event.stopPropagation();

    const isOpen = legendContent.style.display === "block";

    legendContent.style.display = isOpen ? "none" : "block";
    legendArrow.textContent = isOpen ? "▾" : "▴";
    legendToggle.setAttribute("aria-expanded", isOpen ? "false" : "true");
});


// ============================================================
// INFO PANEL CLICKS (event delegation, because the panel
// content is rebuilt often)
// ============================================================

infoContent.addEventListener("click", function (event) {

    // ---- SEE MORE (opens cemetery record lightbox) ----
    const seeMore = event.target.closest(".see-more-button");

    if (seeMore) {
        cemeteryLightboxFrame.src =
            "cemetery.html?id=" + encodeURIComponent(seeMore.dataset.cemeteryId);
        cemeteryLightbox.style.display = "flex";
        return;
    }

    // ---- SHARED MARKER: INDIVIDUAL PERSON ----
    const personButton = event.target.closest(".shared-marker-person-button");

    if (personButton) {

        const cemeteryID = decodeURIComponent(personButton.dataset.sharedCemetery);
        const markerID = decodeURIComponent(personButton.dataset.sharedMarker);
        const index = parseInt(personButton.dataset.sharedIndex, 10);

        const group = getGroups(cemeteryID)[markerID];
        const person = group && group[index];

        if (person) {
            handleGraveClick({
                features: [{
                    properties: {
                        Cemetery_ID: cemeteryID,
                        Person_Data: JSON.stringify([person])
                    }
                }],
                originalEvent: event
            });
        }

        return;
    }

    // ---- SHARED MARKER: VIEW ALL ----
    const viewAll = event.target.closest(".shared-marker-view-all-button");

    if (viewAll) {
        showSharedMarkerPanel(
            decodeURIComponent(viewAll.dataset.sharedCemetery),
            decodeURIComponent(viewAll.dataset.sharedMarker),
            true
        );
    }
});


// ============================================================
// CEMETERY BOUNDARY (test polygon)
// ============================================================

function updateCemeteryBoundary() {

    const visible =
        !!selectedCemeteryFeature &&
        cleanString(selectedCemeteryFeature.properties.Cemetery_ID) ===
            TEST_BOUNDARY_CEMETERY_ID;

    ["cemetery-boundary-fill", "cemetery-boundary-outline"].forEach(function (id) {
        if (map.getLayer(id)) {
            map.setLayoutProperty(id, "visibility", visible ? "visible" : "none");
        }
    });
}

function testBoundaryFeatures() {

    if (!testBoundaryData) {
        return [];
    }

    return (testBoundaryData.features || []).filter(function (feature) {
        return feature.properties &&
            cleanString(feature.properties.CEMETERY_ID) === "TEST001";
    });
}

function loadTestBoundary() {

    fetch(new URL(TEST_BOUNDARY_FILE, document.baseURI).href)
        .then(function (response) {
            if (!response.ok) {
                throw new Error("HTTP " + response.status);
            }
            return response.json();
        })
        .then(function (data) {

            testBoundaryData = data;

            const source = map.getSource("cemetery-boundary");

            if (source) {
                source.setData({
                    type: "FeatureCollection",
                    features: testBoundaryFeatures()
                });
            }

            // If a cemetery was clicked before this finished loading.
            updateCemeteryBoundary();

            if (selectedCemeteryFeature) {
                fitSelectedCemetery();
            }
        })
        .catch(function (error) {
            console.error(TEST_BOUNDARY_FILE + " loading error:", error);
        });
}

function getTestBoundaryBounds() {

    const features = testBoundaryFeatures();

    if (!features.length) {
        return null;
    }

    const bounds = new maplibregl.LngLatBounds();

    function extendCoordinates(coords) {

        if (!Array.isArray(coords)) {
            return;
        }

        if (
            coords.length >= 2 &&
            typeof coords[0] === "number" &&
            typeof coords[1] === "number"
        ) {
            bounds.extend(coords);
            return;
        }

        coords.forEach(extendCoordinates);
    }

    features.forEach(function (feature) {
        extendCoordinates(feature.geometry && feature.geometry.coordinates);
    });

    return bounds.isEmpty() ? null : bounds;
}


// ============================================================
// INDIVIDUAL GRAVES + SHARED PHYSICAL MARKERS
//
// MARKER_ID rules:
//   Blank / one occurrence -> normal individual marker (dot)
//   2+ occurrences         -> one shared marker (ring + dot)
//
// A shared marker uses the first valid LAT/LONG found for that
// MARKER_ID as its representative location.
// ============================================================

const EMPTY_COLLECTION = { type: "FeatureCollection", features: [] };

function setLayerVisibility(id, visibility) {
    if (map.getLayer(id)) {
        map.setLayoutProperty(id, "visibility", visibility);
    }
}

function updateCemeteryGraves() {

    const gravesSource = map.getSource("graves-data");
    const sharedSource = map.getSource("shared-markers-data");

    if (!gravesSource) {
        return;
    }

    // ---- nothing selected: hide everything ----
    if (!selectedCemeteryFeature) {

        gravesSource.setData(EMPTY_COLLECTION);

        if (sharedSource) {
            sharedSource.setData(EMPTY_COLLECTION);
        }

        setLayerVisibility("graves-layer", "none");
        setLayerVisibility("shared-markers-outer-layer", "none");
        setLayerVisibility("shared-markers-inner-layer", "none");

        return;
    }

    const cemeteryID = cleanString(selectedCemeteryFeature.properties.Cemetery_ID);
    const data = intermentsByCemetery[cemeteryID] || { rows: [], groups: {} };
    const groups = data.groups || {};

    // ---- individual graves ----
    const graveFeatures = [];

    (data.rows || []).forEach(function (person, index) {

        const group = person.markerID ? groups[person.markerID] : null;

        // 2+ people sharing a MARKER_ID become ONE shared marker.
        if (group && group.length >= 2) {
            return;
        }

        if (!Array.isArray(person.coordinates)) {
            return;
        }

        graveFeatures.push({
            type: "Feature",
            properties: {
                Cemetery_ID: cemeteryID,
                Grave_Index: index + 1,
                Person_Name: person.name,
                Veteran: person.veteran,
                Birth: person.birth || "",
                Death: person.death || "",
                Row: person.row || "",
                Plot: person.plot || "",
                Stone_Info: person.stoneInfo || "",
                Vet_Details: person.vetDetails || "",
                Marker_ID: person.markerID || "",
                Person_Data: JSON.stringify([person])
            },
            geometry: { type: "Point", coordinates: person.coordinates }
        });
    });

    gravesSource.setData({ type: "FeatureCollection", features: graveFeatures });
    setLayerVisibility("graves-layer", "visible");

    // ---- shared markers ----
    if (sharedSource) {

        const sharedFeatures = [];

        Object.keys(groups).forEach(function (markerID) {

            const group = groups[markerID];

            if (!group || group.length < 2) {
                return;
            }

            const representative = group.find(function (person) {
                return Array.isArray(person.coordinates);
            });

            if (!representative) {
                return;
            }

            sharedFeatures.push({
                type: "Feature",
                properties: {
                    Cemetery_ID: cemeteryID,
                    Marker_ID: markerID,
                    Person_Count: group.length
                },
                geometry: { type: "Point", coordinates: representative.coordinates }
            });
        });

        sharedSource.setData({ type: "FeatureCollection", features: sharedFeatures });
        setLayerVisibility("shared-markers-outer-layer", "visible");
        setLayerVisibility("shared-markers-inner-layer", "visible");
    }
}

function fitSelectedCemetery() {

    if (!selectedCemeteryFeature) {
        return;
    }

    const cemeteryID = cleanString(selectedCemeteryFeature.properties.Cemetery_ID);

    const bounds =
        cemeteryID === TEST_BOUNDARY_CEMETERY_ID
            ? getTestBoundaryBounds()
            : null;

    const graveCoordinates =
        (intermentsByCemetery[cemeteryID] || {}).coordinates || [];

    const target = bounds || new maplibregl.LngLatBounds(
        selectedCemeteryFeature.geometry.coordinates,
        selectedCemeteryFeature.geometry.coordinates
    );

    graveCoordinates.forEach(function (coordinate) {
        target.extend(coordinate);
    });

    map.fitBounds(target, { padding: 30, maxZoom: 50, duration: 1000 });
}

function enterCemeteryMode(feature) {

    selectedCemeteryFeature = feature;
    infoPanel.style.display = "block";

    updateCemeteryBoundary();
    updateCemeteryGraves();
    fitSelectedCemetery();
}

function exitCemeteryMode() {

    selectedCemeteryFeature = null;
    removeHoverLabel();

    updateCemeteryBoundary();
    updateCemeteryGraves();

    showDefaultInfo();
    infoPanel.style.display = "block";

    map.flyTo({ center: DEFAULT_CENTER, zoom: DEFAULT_ZOOM, duration: 800 });
}


