function loadLakeCemeteries(path) {

    Papa.parse(path, {

        download: true,
        header: true,
        skipEmptyLines: true,

        complete: function (lakeResults) {

            const lakeCemeteries = lakeResults.data.filter(function (row) {
                return cleanString(row.NAME) !== "";
            });

            if (lakeCemeteries.length === 0) {
                processMapFilters();
                return;
            }

            // Representative location
            const lakeLocation = [-84.99056446430546, 39.471294950413316];

            map.addSource("lake-cemeteries-data", {
                type: "geojson",
                data: {
                    type: "FeatureCollection",
                    features: [{
                        type: "Feature",
                        properties: { Cemetery_Count: lakeCemeteries.length },
                        geometry: { type: "Point", coordinates: lakeLocation }
                    }]
                }
            });

            map.addLayer({
                id: "lake-cemeteries-layer",
                type: "circle",
                source: "lake-cemeteries-data",
                paint: {
                    "circle-radius": 16,
                    "circle-color": "#555555",
                    "circle-opacity": 0.65,
                    "circle-stroke-width": 3,
                    "circle-stroke-color": "#222222",
                    "circle-stroke-opacity": 0.8
                }
            });

            // Water-wave symbol drawn on top of the marker
            const historicWave = document.createElement("div");
            historicWave.style.width = "32px";
            historicWave.style.height = "32px";
            historicWave.style.pointerEvents = "none";

            historicWave.innerHTML = `
                <svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 12 Q8 8 12 12 T20 12 T28 12"
                          fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
                    <path d="M4 20 Q8 16 12 20 T20 20 T28 20"
                          fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
                </svg>`;

            new maplibregl.Marker({ element: historicWave, anchor: "center" })
                .setLngLat(lakeLocation)
                .addTo(map);

            // ---- click: list every historic cemetery ----
            map.on("click", "lake-cemeteries-layer", function () {

                infoPanel.style.display = "block";

                const optionalFields = [
                    ["ALTERNATE NAME", "Alternate Name"],
                    ["DESIGNATION", "Designation"],
                    ["ORIGINAL LOCATION", "Original Location"],
                    ["TOWNSHIP", "Township"],
                    ["MOVED TO", "Moved To"],
                    ["NOTES", "Notes"]
                ];

                let cemeteryList = "";

                lakeCemeteries.forEach(function (row) {

                    cemeteryList += `
                        <div class="lake-cemetery">
                            <h3>${escapeHtml(row.NAME || "Unnamed Cemetery")}</h3>`;

                    optionalFields.forEach(function (field) {
                        if (row[field[0]]) {
                            cemeteryList += popupField(field[1], row[field[0]]);
                        }
                    });

                    cemeteryList += `</div>`;
                });

                infoContent.innerHTML = `
                    <h2>Historic Fairfield Cemeteries</h2>

                    <p class="lake-introduction">
                        Cemeteries affected by the construction of Brookville Lake.
                        Individual former cemetery locations are not currently mapped.
                    </p>

                    <p class="lake-introduction">
                        <strong>${lakeCemeteries.length}</strong>
                        documented ${lakeCemeteries.length === 1 ? "cemetery" : "cemeteries"}.
                    </p>

                    ${cemeteryList}`;
            });

            map.on("mouseenter", "lake-cemeteries-layer", function () {
                map.getCanvas().style.cursor = "pointer";
            });

            map.on("mouseleave", "lake-cemeteries-layer", function () {
                map.getCanvas().style.cursor = "";
            });

            processMapFilters();
        },

        error: function (error) {
            console.error("lakecems.csv loading error:", error);
            processMapFilters();
        }
    });
}


