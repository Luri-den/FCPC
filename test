// ============================================================
// OFF-SCREEN SEARCH DIRECTIONS
// ============================================================

function updateSearchDirections() {

    searchDirections.innerHTML = "";

    const searchIsActive = searchBox.value.trim() !== "" || veteransOnly;

    if (!searchIsActive) {
        return;
    }

    const filterYear = parseInt(yearSlider.value, 10);
    const width = map.getContainer().clientWidth;
    const height = map.getContainer().clientHeight;

    if (!width || !height) {
        return;
    }

    const centerX = width / 2;
    const centerY = height / 2;

    const isMobile = window.matchMedia("(max-width: 700px)").matches;

    // Keep indicators slightly inside the map edge. On mobile the
    // right side stays farther inward because of controls/info.
    const edgePadding = isMobile ? 8 : 18;
    const edgePaddingRight = isMobile ? 85 : 18;

    const halfW = width / 2 - (edgePadding + edgePaddingRight) / 2;
    const halfH = height / 2 - edgePadding;

    const usedPositions = [];

    function clampX(x) {
        return Math.max(edgePadding, Math.min(width - edgePaddingRight, x));
    }

    function clampY(y) {
        return Math.max(edgePadding, Math.min(height - edgePadding, y));
    }

    cemeteryFeatures.forEach(function (feature) {

        const props = feature.properties;

        // Only matched cemeteries get an indicator.
        if (props.Search_Match !== true) {
            return;
        }

        // Respect the year filter.
        const establishedYear = Number(props.Established_Year);

        if (
            filterYear < 1900 &&
            !(establishedYear > 0 && establishedYear <= filterYear)
        ) {
            return;
        }

        const coordinates = feature.geometry.coordinates;
        const point = map.project(coordinates);

        // Already visible: no arrow needed.
        if (point.x >= 0 && point.x <= width && point.y >= 0 && point.y <= height) {
            return;
        }

        // Direction from map center toward the cemetery.
        const dx = point.x - centerX;
        const dy = point.y - centerY;

        if (dx === 0 && dy === 0) {
            return;
        }

        // Where that direction crosses the map edge.
        const edgeScale = Math.min(Math.abs(halfW / dx), Math.abs(halfH / dy));

        let x = clampX(centerX + dx * edgeScale);
        let y = clampY(centerY + dy * edgeScale);

        // Nudge so indicators don't sit directly on top of each other.
        for (let i = 0; i < usedPositions.length; i++) {

            const used = usedPositions[i];
            const distance = Math.hypot(x - used.x, y - used.y);

            if (distance < 32) {

                const nudge = 34 - distance;
                const length = Math.hypot(dx, dy) || 1;

                x += (-dy / length) * nudge;
                y += (dx / length) * nudge;
            }
        }

        x = clampX(x);
        y = clampY(y);

        usedPositions.push({ x: x, y: y });

        const angle = Math.atan2(dy, dx) * 180 / Math.PI;

        const indicator = document.createElement("div");
        indicator.className = "search-direction";
        indicator.style.left = x + "px";
        indicator.style.top = y + "px";
        indicator.style.transform = "translate(-50%, -50%)";
        indicator.title = "Go to " + (props.Cemetery_Name || "Cemetery");

        const arrow = document.createElement("span");
        arrow.className = "search-direction-arrow";
        arrow.textContent = "➤";
        arrow.style.transform = "rotate(" + angle + "deg)";

        const name = document.createElement("span");
        name.className = "search-direction-name";
        name.textContent = props.Cemetery_Name || "Unnamed Cemetery";

        indicator.appendChild(arrow);
        indicator.appendChild(name);

        // Clicking the indicator brings the cemetery into view.
        indicator.addEventListener("click", function (event) {
            event.stopPropagation();
            map.flyTo({ center: coordinates, duration: 500 });
        });

        searchDirections.appendChild(indicator);
    });
}


// ============================================================
// SEARCH / FILTER PROCESSOR
// ============================================================

function processMapFilters() {

    const searchStr = searchBox.value.toLowerCase().trim();
    const filterYear = parseInt(yearSlider.value, 10);
    const searchIsActive = searchStr !== "" || veteransOnly;

    // ---- clear button + year label ----
    clearSearch.style.display = searchBox.value !== "" ? "block" : "none";
    yearVal.innerText = filterYear < 1900 ? filterYear : "All";

    // ---- calculate search matches ----
    cemeteryFeatures.forEach(function (feature) {

        const props = feature.properties;
        const cemeteryID = cleanString(props.Cemetery_ID);

        const cemeteryText =
            (String(props.Cemetery_Name || "") + " " + String(props.Other_Names || ""))
                .toLowerCase();

        const intermentData =
            intermentsByCemetery[cemeteryID] || { people: [], veteran: false };

        const personText = intermentData.people.join(" ").toLowerCase();

        let textMatch = searchStr === "";

        if (searchStr !== "") {
            if (searchCemetery && cemeteryText.includes(searchStr)) {
                textMatch = true;
            }
            if (searchPerson && personText.includes(searchStr)) {
                textMatch = true;
            }
        }

        // Veteran match: cemlist.csv VETS = 1 OR interments.csv VETERAN = 1
        const hasVeteran = Number(props.Vets) === 1 || intermentData.veteran;
        const veteranMatch = !veteransOnly || hasVeteran;

        props.Search_Match = textMatch && veteranMatch;
        props.Search_Active = searchIsActive;
    });

    // Map layers may not exist yet (data still loading).
    if (!map.getLayer("cemeteries-layer")) {
        updateSearchDirections();
        return;
    }

    // ---- update map source ----
    const source = map.getSource("cemeteries-data");

    if (source) {
        source.setData({ type: "FeatureCollection", features: cemeteryFeatures });
    }

    // ---- main cemetery filter ----
    const activeFilters = ["all"];

    if (filterYear < 1900) {
        activeFilters.push([
            "all",
            [">", ["get", "Established_Year"], 0],
            ["<=", ["get", "Established_Year"], filterYear]
        ]);
    }

    if (searchIsActive) {
        activeFilters.push(["==", ["get", "Search_Match"], true]);
    }

    map.setFilter("cemeteries-layer", activeFilters.length > 1 ? activeFilters : null);

    // ---- highlight filter ----
    if (map.getLayer("cemeteries-highlight-layer")) {

        if (searchIsActive) {
            map.setFilter("cemeteries-highlight-layer", [
                "all",
                ["==", ["get", "Search_Active"], true],
                ["==", ["get", "Search_Match"], true]
            ]);
        }
        else {
            map.setFilter("cemeteries-highlight-layer", [
                "==", ["get", "Search_Active"], true
            ]);
        }
    }

    // ---- off-screen search arrows ----
    updateSearchDirections();
}


// ============================================================
// INTERMENTS (people / graves / shared markers)
// ============================================================

function loadInterments(path) {

    Papa.parse(path, {

        download: true,
        header: true,
        skipEmptyLines: true,

        complete: function (results) {

            intermentsByCemetery = {};

            results.data.forEach(function (row) {

                const cemeteryID = cleanString(row.CEMETERY_ID);

                if (!cemeteryID) {
                    return;
                }

                if (!intermentsByCemetery[cemeteryID]) {
                    intermentsByCemetery[cemeteryID] = {
                        people: [],
                        veteran: false,
                        coordinates: [],
                        rows: [],
                        groups: {}
                    };
                }

                const entry = intermentsByCemetery[cemeteryID];

                const firstName = cleanString(row["FIRST NAME"]);
                const lastName = cleanString(row["LAST NAME"]);
                const fullName = (firstName + " " + lastName).trim();
                const markerID = cleanString(row.MARKER_ID);

                const lat = parseFloat(row.LAT);
                const lon = parseFloat(row.LONG);
                const hasCoordinates = !isNaN(lat) && !isNaN(lon);

                const person = {
                    name: fullName || "Unnamed Interment",
                    firstName: firstName,
                    lastName: lastName,
                    birth: cleanString(row.BIRTH),
                    death: cleanString(row.DEATH),
                    row: cleanString(row.ROW),
                    plot: cleanString(row.PLOT),
                    stoneInfo: cleanString(row["ADDITIONAL INFORMATION ON STONE"]),
                    veteran: cleanString(row.VETERAN) === "1",
                    vetDetails: cleanString(row["VET DETAILS"]),
                    markerID: markerID,
                    coordinates: hasCoordinates ? [lon, lat] : null
                };

                if (fullName) {
                    entry.people.push(fullName);
                }

                if (person.veteran) {
                    entry.veteran = true;
                }

                if (hasCoordinates) {
                    entry.coordinates.push(person.coordinates);
                }

                entry.rows.push(person);

                // Only nonblank MARKER_ID values enter a group.
                if (markerID) {
                    if (!entry.groups[markerID]) {
                        entry.groups[markerID] = [];
                    }
                    entry.groups[markerID].push(person);
                }
            });

            intermentsLoaded = true;

            if (selectedCemeteryFeature) {
                updateCemeteryGraves();
                fitSelectedCemetery();
            }

            // Refresh search now that people are available.
            processMapFilters();
        },

        error: function (error) {
            console.error("interments.csv loading error:", error);
        }
    });
}


